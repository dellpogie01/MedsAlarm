steps {
  type: CORTEX_STEP_TYPE_USER_INPUT
  status: CORTEX_STEP_STATUS_DONE
  metadata {
    created_at {
      seconds: 1792168399
      nanos: 737700834
    }
    source: CORTEX_STEP_SOURCE_USER_EXPLICIT
    source_trajectory_step_info {
      trajectory_id: "752b5281-aef7-4554-9d57-f9c788f21ffa"
      step_index: 1
      cascade_id: "752b5281-aef7-4554-9d57-f9c788f21ffa"
    }
    model_api_content_id: "2cc3e02b11d94034b6966c44b20b0ef9"
