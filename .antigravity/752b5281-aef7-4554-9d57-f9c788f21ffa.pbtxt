      create_file {
        instruction: "package com.example.ui\n\nimport androidx.compose.foundation.background\nimport androidx.compose.foundation.layout.*\nimport androidx.compose.foundation.rememberScrollState\nimport androidx.compose.foundation.selection.toggleable\nimport androidx.compose.foundation.verticalScroll\nimport androidx.compose.material.icons.Icons\nimport androidx.compose.material.icons.automirrored.filled.ArrowBack\nimport androidx.compose.material3.*\nimport androidx.compose.runtime.*\nimport androidx.compose.ui.Alignment\nimport androidx.compose.ui.Modifier\nimport androidx.compose.ui.semantics.Role\nimport androidx.compose.ui.text.font.FontWeight\nimport androidx.compose.ui.unit.dp\nimport com.example.viewmodel.MedsViewModel\n\n@OptIn(ExperimentalMaterial3Api::class)\n@Composable\nfun AddAlarmScreen(\n    viewModel: MedsViewModel,\n    onNavigateBack: () -> Unit\n) {\n    var name by remember { mutableStateOf(\"\") }\n    var dosage by remember { mutableStateOf(\"\") }\n    var instruction by remember { mutableStateOf(\"\") }\n    var formType by remember { mutableStateOf(\"tablet\") } // tablet, capsule, injection\n\n    var hourStr by remember { mutableStateOf(\"08\") }\n    var minuteStr by remember { mutableStateOf(\"00\") }\n    var amPm by remember { mutableStateOf(\"AM\") }\n\n    val daysOfWeek = listOf(\"S\", \"M\", \"T\", \"W\", \"T\", \"F\", \"S\")\n    val selectedDays = remember { mutableStateMapOf<Int, Boolean>().apply { daysOfWeek.indices.forEach { put(it, true) } } }\n\n    var doseCount by remember { mutableIntStateOf(2) } // 1x, 2x, 3x, 5x\n\n    var notifyStatusbar by remember { mutableStateOf(true) }\n    var notifySound by remember { mutableStateOf(true) }\n    var notifyVibrate by remember { mutableStateOf(true) }\n\n    Scaffold(\n        topBar = {\n            TopAppBar(\n                title = { Text(\"Add Medication Reminder\") },\n                navigationIcon = {\n                    IconButton(onClick = onNavigateBack) {\n                        Icon(Icons.AutoMirrored.Filled.ArrowBack, contentDescription = \"Back\")\n                    }\n                },\n                colors = TopAppBarDefaults.topAppBarColors(\n                    containerColor = MaterialTheme.colorScheme.primaryContainer,\n                    titleContentColor = MaterialTheme.colorScheme.primary\n                )\n            )\n        }\n    ) { innerPadding ->\n        Column(\n            modifier = Modifier\n                .fillMaxSize()\n                .padding(innerPadding)\n                .verticalScroll(rememberScrollState())\n                .padding(16.dp),\n            verticalArrangement = Arrangement.spacedBy(16.dp)\n        ) {\n            OutlinedTextField(\n                value = name,\n                onValueChange = { name = it },\n                label = { Text(\"Medicine Name *\") },\n                modifier = Modifier.fillMaxWidth(),\n                singleLine = true\n            )\n\n            OutlinedTextField(\n                value = dosage,\n                onValueChange = { dosage = it },\n                label = { Text(\"Dosage (e.g., 3 mg, 1 Tab) *\") },\n                modifier = Modifier.fillMaxWidth(),\n                singleLine = true\n            )\n\n            OutlinedTextField(\n                value = instruction,\n                onValueChange = { instruction = it },\n                label = { Text(\"Instruction (Optional)\") },\n                modifier = Modifier.fillMaxWidth(),\n                maxLines = 3\n            )\n\n            // Medication Form Selection\n            Text(\"Medication Form\", style = MaterialTheme.typography.titleSmall)\n            Row(\n                modifier = Modifier.fillMaxWidth(),\n                horizontalArrangement = Arrangement.spacedBy(8.dp)\n            ) {\n                listOf(\"tablet\", \"capsule\", \"injection\").forEach { form ->\n                    FilterChip(\n                        selected = formType == form,\n                        onClick = { formType = form },\n                        label = { Text(form.replaceFirstChar { it.uppercase() }) },\n                        modifier = Modifier.weight(1f)\n                    )\n                }\n            }\n\n            // Time Picker (Hour, Minute, AM/PM)\n            Text(\"First Dose Time\", style = MaterialTheme.typography.titleSmall)\n            Row(\n                modifier = Modifier.fillMaxWidth(),\n                horizontalArrangement = Arrangement.spacedBy(8.dp),\n                verticalAlignment = Alignment.CenterVertically\n            ) {\n                OutlinedTextField(\n                    value = hourStr,\n                    onValueChange = { if (it.length <= 2) hourStr = it.filter { c -> c.isDigit() } },\n                    label = { Text(\"Hour (1-12)\") },\n                    modifier = Modifier.weight(1f),\n                    singleLine = true\n                )\n                Text(\":\", style = MaterialTheme.typography.titleLarge)\n                OutlinedTextField(\n                    value = minuteStr,\n                    onValueChange = { if (it.length <= 2) minuteStr = it.filter { c -> c.isDigit() } },\n                    label = { Text(\"Minute (00-59)\") },\n                    modifier = Modifier.weight(1f),\n                    singleLine = true\n                )\n                // AM/PM Segmented / Switch\n                Row(modifier = Modifier.weight(1.2f)) {\n                    listOf(\"AM\", \"PM\").forEach { ap ->\n                        FilterChip(\n                            selected = amPm == ap,\n                            onClick = { amPm = ap },\n                            label = { Text(ap) },\n                            modifier = Modifier.weight(1f)\n                        )\n                    }\n                }\n            }\n\n            // Repeat Days\n            Text(\"Repeat Days\", style = MaterialTheme.typography.titleSmall)\n            Row(\n                modifier = Modifier.fillMaxWidth(),\n                horizontalArrangement = Arrangement.SpaceBetween\n            ) {\n                daysOfWeek.forEachIndexed { index, day ->\n                    val isSelected = selectedDays[index] == true\n                    FilterChip(\n                        selected = isSelected,\n                        onClick = { selectedDays[index] = !isSelected },\n                        label = { Text(day) }\n                    )\n                }\n            }\n\n            // Dose Times Per Day\n            Text(\"Dose Times Per Day\", style = MaterialTheme.typography.titleSmall)\n            Row(\n                modifier = Modifier.fillMaxWidth(),\n                horizontalArrangement = Arrangement.spacedBy(8.dp)\n            ) {\n                listOf(1, 2, 3, 5).forEach { count ->\n                    FilterChip(\n                        selected = doseCount == count,\n                        onClick = { doseCount = count },\n                        label = { Text(\"${count}x Day\") },\n                        modifier = Modifier.weight(1f)\n                    )\n                }\n            }\n\n            val intervalHours = if (doseCount > 0) 24.0 / doseCount else 24.0\n            Text(\n                text = \"Automatic interval: Every %.1f hours\".format(intervalHours),\n                style = MaterialTheme.typography.bodySmall,\n                color = MaterialTheme.colorScheme.primary\n            )\n\n            // Notification Options\n            Text(\"Notification Options\", style = MaterialTheme.typography.titleSmall)\n            Column(verticalArrangement = Arrangement.spacedBy(4.dp)) {\n                Row(\n                    modifier = Modifier\n                        .fillMaxWidth()\n                        .toggleable(value = notifyStatusbar, onValueChange = { notifyStatusbar = it }, role = Role.Checkbox),\n                    verticalAlignment = Alignment.CenterVertically\n                ) {\n                    Checkbox(checked = notifyStatusbar, onCheckedChange = null)\n                    Spacer(modifier = Modifier.width(8.dp))\n                    Text(\"Status Bar Notification\")\n                }\n                Row(\n                    modifier = Modifier\n                        .fillMaxWidth()\n                        .toggleable(value = notifySound, onValueChange = { notifySound = it }, role = Role.Checkbox),\n                    verticalAlignment = Alignment.CenterVertically\n                ) {\n                    Checkbox(checked = notifySound, onCheckedChange = null)\n                    Spacer(modifier = Modifier.width(8.dp))\n                    Text(\"Sound Alarm\")\n                }\n                Row(\n                    modifier = Modifier\n                        .fillMaxWidth()\n                        .toggleable(value = notifyVibrate, onValueChange = { notifyVibrate = it }, role = Role.Checkbox),\n                    verticalAlignment = Alignment.CenterVertically\n                ) {\n                    Checkbox(checked = notifyVibrate, onCheckedChange = null)\n                    Spacer(modifier = Modifier.width(8.dp))\n                    Text(\"Vibrate Alarm\")\n                }\n            }\n\n            Spacer(modifier = Modifier.height(8.dp))\n\n            Button(\n                onClick = {\n                    if (name.isBlank() || dosage.isBlank()) return@Button\n                    val h = hourStr.toIntOrNull() ?: 8\n                    val m = minuteStr.toIntOrNull() ?: 0\n                    val repeatStr = selectedDays.entries.filter { it.value }.joinToString(\",\") { it.key.toString() }\n\n                    viewModel.addMedication(\n                        name = name.trim(),\n                        dosage = dosage.trim(),\n                        instruction = instruction.trim(),\n                        formType = formType,\n                        firstHour = h,\n                        firstMinute = m,\n                        amPm = amPm,\n                        repeatDays = repeatStr,\n                        doseCountPerDay = doseCount,\n                        intervalHours = intervalHours,\n                        notifyStatusbar = notifyStatusbar,\n                        notifySound = notifySound,\n                        notifyVibrate = notifyVibrate\n                    )\n                    onNavigateBack()\n                },\n                modifier = Modifier\n                    .fillMaxWidth()\n                    .height(50.dp)\n                    .testTag(\"btn_save_alarm\"),\n                colors = ButtonDefaults.buttonColors(containerColor = MaterialTheme.colorScheme.primary)\n            ) {\n                Text(\"Set Alarm\", style = MaterialTheme.typography.titleMedium)\n            }\n        }\n    }\n}\n"
